n = int(input("Введите число: "))

nachalnoe_chislo = 1

while nachalnoe_chislo <= n:
    if (5 <= nachalnoe_chislo <= 9) or (17 <= nachalnoe_chislo <= 37) or (78 <= nachalnoe_chislo <= 87):
        nachalnoe_chislo += 1
        continue
    else:
        print(nachalnoe_chislo)
        nachalnoe_chislo += 1
